# Suppressions for make ctgrind, which is tools/ctgrind.c under memcheck.
#
# Each entry is a branch that Go's code takes on a secret too, at the same
# place. None of them can tell an attacker more than that a value was invalid,
# or something that is public anyway. A new report that is not one of these is
# a constant time bug until shown otherwise, and the fix is in the code, not a
# new entry here. The trailing * on a name is for the copies that gcc makes of
# a static function, like ecdh_nist_new_private.isra.0.

# Scalar.signedRadix16 panics on a scalar with the top bit set, which a reduced
# scalar never has.
{
   edwards25519 signedRadix16 high bit panic
   Memcheck:Cond
   fun:burrow__sc_signed_radix16*
}

# checkInitialized panics on a Point whose x and y are both zero, which no
# point on the curve is.
{
   edwards25519 checkInitialized
   Memcheck:Cond
   fun:ge_check_initialized*
}

# p256Table.Select and p256AffineTable.Select panic on an index past the end
# of the table, which a Booth digit never is. The selection itself is masked.
{
   nistec p256Table.Select bounds panic
   Memcheck:Cond
   fun:p256_table_select*
}
{
   nistec p256AffineTable.Select bounds panic
   Memcheck:Cond
   fun:p256_affine_table_select*
}

# ecdh.NewPrivateKey returns an error for a key that is zero or not below the
# order. isZero and isLess are constant time, and the branch on what they say
# only tells whether the key was valid.
{
   ecdh NewPrivateKey scalar check
   Memcheck:Cond
   fun:ecdh_nist_valid_scalar*
}
{
   ecdh NewPrivateKey error
   Memcheck:Cond
   fun:ecdh_nist_new_private*
}

# The X25519 shared secret is checked for all zeros, which only a low order
# remote point gives, and that is an error.
{
   ecdh X25519 low order point
   Memcheck:Cond
   fun:ecdh_private_key_ecdh*
}

# Point.Bytes and Point.BytesX check for the point at infinity, which a valid
# key times a valid point is not.
{
   nistec P-224 Bytes infinity
   Memcheck:Cond
   fun:p224_point_bytes*
}
{
   nistec P-256 Bytes infinity
   Memcheck:Cond
   fun:p256_point_bytes*
}
{
   nistec P-384 Bytes infinity
   Memcheck:Cond
   fun:p384_point_bytes*
}
{
   nistec P-521 Bytes infinity
   Memcheck:Cond
   fun:p521_point_bytes*
}

# sampleNTT is rejection sampling from rho, which comes from the seed but is
# published in the encapsulation key, so how many tries it takes is public.
{
   mlkem sampleNTT rejection sampling
   Memcheck:Cond
   fun:mlkem_sample_ntt*
}

# The generic Poly1305 panics with "poly1305: unexpected overflow" if a sum or
# a product carries out of its 128 bits. The clamped r and the partly reduced h
# keep that from ever happening, so the branch always goes the same way.
{
   poly1305 overflow panic
   Memcheck:Cond
   fun:poly1305_no_overflow*
}

# Open in GCM and in ChaCha20-Poly1305 compares the tag in constant time and
# then fails if it is wrong, which the caller learns from the error anyway.
# With clang the branch is in gcm_open, on what gcm_open_into returns.
{
   gcm Open tag check
   Memcheck:Cond
   fun:gcm_open*
}
{
   chacha20poly1305 Open tag check
   Memcheck:Cond
   fun:chacha20poly1305_open_with*
}

# ECDSA's randomPoint is rejection sampling: a candidate for the nonce that is
# zero or not below the order goes round again, which for these curves almost
# never happens. Nat.SetBytes is where the candidate is compared with the order.
{
   ecdsa randomPoint rejection sampling
   Memcheck:Cond
   fun:ecdsa_random_point*
}
{
   ecdsa randomPoint SetBytes range check
   Memcheck:Cond
   fun:bigmod_nat_set_bytes
   fun:ecdsa_random_point*
}

# sign reads the key with Nat.SetBytes, which fails for a key that is not below
# the order. burrow also reads the nonce from randomPoint back the same way,
# and it always is below the order. Then sign fails if r or s is zero, and its
# SetOverflowingBytes checks the length of r. r and s are the signature, so
# they are public, but they come from the key and the nonce, and only become
# public to valgrind once the harness says so.
{
   ecdsa sign SetBytes range check
   Memcheck:Cond
   fun:bigmod_nat_set_bytes
   fun:burrow__ecdsa_sign_with_drbg*
}
{
   ecdsa sign r or s is zero
   Memcheck:Cond
   fun:burrow__ecdsa_sign_with_drbg*
}
{
   ecdsa sign SetOverflowingBytes on r
   Memcheck:Cond
   fun:bigmod_nat_set_overflowing_bytes
   fun:burrow__ecdsa_sign_with_drbg*
}
{
   ecdsa sign bitLen of r
   Memcheck:Cond
   fun:bit_len
   fun:bigmod_nat_set_overflowing_bytes
   fun:burrow__ecdsa_sign_with_drbg*
}

# Nat.Bytes stops at a zero limb when the bytes run out before the limbs, and
# panics if the limb is not zero. A value reduced modulo the order never has
# bits there, so the branch always goes the same way. With 64 bit limbs, only
# P-224 and P-521 have orders that are not a whole number of limbs.
{
   ecdsa Nat.Bytes spare limb
   Memcheck:Cond
   fun:ecdsa_nat_bytes*
}

# RSA's decrypt, which signing uses too, checks that the result encrypts back
# to the input, and fails with ErrDecryption if not, which only a fault in the
# computation can cause. The other branches in rsa_fips_decrypt are on whether
# the key has CRT values and on the ciphertext, which are public.
{
   rsa decrypt check
   Memcheck:Cond
   fun:rsa_fips_decrypt*
}

# OAEP decryption fails with ErrDecryption when the padding is wrong. The
# padding is checked in constant time, and only the result is branched on.
# Then the message starts after the 0x01 byte, so where it starts and how long
# it is come from the key until the caller has it. Go returns rest[index+1:]
# the same way. burrow copies the message out of the scratch memory, and that
# copy takes its length.
{
   rsa OAEP padding check
   Memcheck:Cond
   fun:rsa_fips_decrypt_oaep*
}
{
   rsa OAEP message start
   Memcheck:Cond
   fun:slice_from
   fun:rsa_sub
   fun:rsa_fips_decrypt_oaep*
}
{
   rsa OAEP message copy
   Memcheck:Cond
   ...
   fun:rsa_clone*
   fun:rsa_decrypt_oaep_hashes*
}
{
   rsa OAEP message copy, address
   Memcheck:Value8
   ...
   fun:rsa_clone*
   fun:rsa_decrypt_oaep_hashes*
}
