# ------------------------------------------------------------ the name rules

# R1: two packages with the same name both get longer, and the list is closed.
# atomic is here because <stdatomic.h> owns atomic_.
PACKAGE_SEGMENT = {
    "crypto/rand": "crypto_rand",
    "math/rand": "math_rand",
    "math/rand/v2": "mathrand2",
    "text/template": "text_template",
    "html/template": "html_template",
    "runtime/pprof": "runtime_pprof",
    "net/http/pprof": "http_pprof",
    "go/scanner": "go_scanner",
    "text/scanner": "text_scanner",
    "encoding/json/v2": "jsonv2",
    "sync/atomic": "sync_atomic",
}

# R2: the acronyms that stay one word even when a lower case letter follows.
ACRONYMS = set(
    "URL HTTP HTTPS TLS TCP UDP IP DNS ID API CPU IO EOF ASN1 DER PEM JSON XML "
    "UTF8 UTF16 RSA ECDSA GCM CBC SHA MD5 CRC FS DB SQL RPC MIME SMTP URI UUID "
    "PKCS OID SAN CA OCSP SCT ALPN SNI QUIC HPACK GZIP ZIP RW".split()
)

# Names the rules would get wrong and the headers spell differently on purpose,
# keyed by the declaration as Go writes it. Each one is argued for in the design
# document it points at, and nothing goes here to make a mistake pass.
RENAMED = {
    # 08-naming-abi.md section 1, the worked examples: Duration is a
    # language level type in practice, and TimeDuration at every call site
    # would be noise.
    ("time", "type Duration"): "Duration",
    # include/burrow/sync.h: Go's three Once wrappers return closures that the
    # collector frees. Here the state is a struct you declare and the macro
    # fills in, so each Go function becomes an initialiser.
    ("sync", "func OnceFunc"): "SYNC_ONCE_FUNC",
    ("sync", "func OnceValue"): "SYNC_ONCE_VALUE",
    ("sync", "func OnceValues"): "SYNC_ONCE_VALUES",
    # include/burrow/sync.h: NewCond allocates in Go and has nothing to
    # allocate here, so it is the initialiser too.
    ("sync", "func NewCond"): "SYNC_COND",
    # include/burrow/error.h: errors_as already returns the typed pointer,
    # which is the shape AsType was added to Go to get.
    ("errors", "func AsType"): "errors_as",
    # new is a keyword in C++, and burrow.h has to compile there.
    ("sync", "type Pool struct, New"): "SyncPool.new_fn",
    # 08-naming-abi.md section 0: libuuid and macOS's libc define both of
    # these with other signatures, and burrow-gen collisions says so.
    ("uuid", "func Parse"): "uuid_parse_str",
    ("uuid", "method (UUID) Compare"): "uuid_cmp",
}


def segment(path):
    """R1: the package segment, which is the package name unless it collides."""
    if path in PACKAGE_SEGMENT:
        return PACKAGE_SEGMENT[path]
    last = path.rsplit("/", 1)[-1]
    if re.fullmatch(r"v[0-9]+", last) and "/" in path:
        last = path.rsplit("/", 2)[-2]
    return last


def words(name):
    """R2: split a Go identifier into the words its snake case is made of."""
    # NaN is one word, so IsNaN is is_nan and not is_na_n.
    name = name.replace("NaN", "Nan")
    out = []
    for part in name.split("_"):
        i = 0
        n = len(part)
        while i < n:
            c = part[i]
            if c.isupper():
                j = i
                while j < n and part[j].isupper():
                    j += 1
                # A run of capitals. Digits that follow stay with it, so UTF8
                # and Int64 are one word each.
                k = j
                while k < n and part[k].isdigit():
                    k += 1
                run = part[i:j]
                if k < n and part[k].islower() and k == j and len(run) > 1:
                    # ReadHTTPClient: the last capital starts the next word,
                    # unless the whole run is an acronym. Then a plural s or a
                    # version like the v4 in IPv4 stays with it, and anything
                    # else is a word of its own.
                    if run in ACRONYMS:
                        m = k
                        while m < n and part[m].islower():
                            m += 1
                        tail = part[k:m]
                        if tail == "s" or (m < n and part[m].isdigit()):
                            while m < n and part[m].isdigit():
                                m += 1
                            out.append(part[i:m])
                            i = m
                        else:
                            out.append(run)
                            i = j
                        continue
                    out.append(run[:-1])
                    i = j - 1
                    continue
                if k < n and part[k].islower() and k == j:
                    # One capital and then lower case: an ordinary word.
                    m = k
                    while m < n and (part[m].islower() or part[m].isdigit()):
                        m += 1
                    out.append(part[i:m])
                    i = m
                    continue
                out.append(part[i:k])
                i = k
            else:
                m = i
                while m < n and not part[m].isupper():
                    m += 1
                if out and part[i].isdigit():
                    out[-1] += part[i:m]
                else:
                    out.append(part[i:m])
                i = m
    return [w for w in out if w]


def snake(name):
    return "_".join(w.lower() for w in words(name))


def camel_segment(seg):
    return "".join(p[:1].upper() + p[1:] for p in seg.split("_"))


def type_name(path, name):
    """R4: package and type run together, with the eponym collapse."""
    key = (path, "type " + name)
    if key in RENAMED:
        return RENAMED[key]
    seg = segment(path)
    last = seg.rsplit("_", 1)[-1]
    if name.lower() == last.lower() or name.lower() == seg.replace("_", "").lower():
        return camel_segment(seg[: -len(last)].rstrip("_")) + name[:1].upper() + name[1:].lower()
    return camel_segment(seg) + name


def type_snake(path, name):
    """R6: the method prefix, which is the C type name in snake case."""
    return snake(type_name(path, name))


# ------------------------------------------------------ Go's API manifest


class Decl:
    """One line of the manifest, and what it becomes in C."""

    def __init__(self, path, text):
        self.path = path
        self.text = text
        self.key = text
        self.cname = None
        self.owner = None  # the C struct or vtable a member has to be in
        self.member = None
        self.alternative = None
        self.status = None
        self.renamed = False
        self.why = None


def map_decl(d):
    map_by_rule(d)
    to = RENAMED.get((d.path, d.key))
    if to is None:
        return
    d.renamed = True
    if "." in to:
        d.owner, d.member = to.split(".", 1)
        d.alternative = None
    else:
        d.owner = d.member = d.alternative = None
        d.cname = to


def map_by_rule(d):
    path, text = d.path, d.text
    seg = segment(path)
    m = re.match(r"^const (\w+)", text)
    if m:
        d.key = m.group(0)
        d.cname = (seg + "_" + snake(m.group(1))).upper()
        return
    m = re.match(r"^var (\w+)", text)
    if m:
        d.key = m.group(0)
        d.cname = seg + "_" + snake(m.group(1))
        return
    m = re.match(r"^func (\w+)", text)
    if m:
        d.key = m.group(0)
        d.cname = seg + "_" + snake(m.group(1))
        return
    m = re.match(r"^method \((\*?)(\w+)(\[[^\]]*\])?\) (\w+)", text)
    if m:
        d.key = "method (%s%s) %s" % (m.group(1), m.group(2), m.group(4))
        d.cname = type_snake(path, m.group(2)) + "_" + snake(m.group(4))
        return
    m = re.match(r"^type (\w+)(\[[^\]]*\])? (struct|interface), (.*)$", text)
    if m:
        tname, kind, rest = m.group(1), m.group(3), m.group(4)
        owner = type_name(path, tname)
        if rest == "unexported methods":
            d.key = "type %s interface, unexported methods" % tname
            d.cname = owner
            return
        if rest.startswith("embedded "):
            what = rest[len("embedded "):].lstrip("*").rsplit(".", 1)[-1]
            d.key = "type %s struct, embedded %s" % (tname, what)
            d.owner = owner
            d.member = snake(what)
            return
        fm = re.match(r"(\w+)", rest)
        d.key = "type %s %s, %s" % (tname, kind, fm.group(1))
        if kind == "struct":
            d.owner = owner
            d.member = snake(fm.group(1))
        else:
            d.owner = owner + "VT"
            d.member = snake(fm.group(1))
            d.alternative = type_snake(path, tname) + "_" + snake(fm.group(1))
        return
    m = re.match(r"^type (\w+)", text)
    if m:
        d.key = m.group(0)
        d.cname = type_name(path, m.group(1))
        return
    raise SystemExit("%s: cannot read this line of the Go API: pkg %s, %s" % (PROG, path, text))


def goroot():
    root = os.environ.get("GOROOT")
    if root:
        return root
    try:
        return subprocess.run(["go", "env", "GOROOT"], check=True, capture_output=True, text=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        raise SystemExit("%s: needs a Go toolchain on PATH or GOROOT set" % PROG)


LINE = re.compile(r"^pkg ([^ ,]+)(?: \(([^)]*)\))?, (.*)$")


def read_api(api_dir, targets):
    files = sorted(glob.glob(os.path.join(api_dir, "go1*.txt")))
    if not files:
        raise SystemExit("%s: no go1*.txt in %s" % (PROG, api_dir))
    want = set(targets)
    seen = set()
    by_pkg = {}
    for f in files:
        with open(f) as fh:
            for line in fh:
                m = LINE.match(line.rstrip("\n"))
                if not m:
                    continue
                path, plat, text = m.groups()
                if plat is not None and re.sub(r"-cgo$", "", plat) not in want:
                    continue
                if (path, text) in seen:
                    continue
                seen.add((path, text))
                by_pkg.setdefault(path, []).append(Decl(path, text))
    return by_pkg


def public_packages():
    out = subprocess.run(["go", "list", "std"], check=True, capture_output=True, text=True).stdout.split()
    return [p for p in out if not re.search(r"(^|/)(internal|vendor)(/|$)", p) and not p.startswith("cmd/")]


# ------------------------------------------------------------ the headers


def strip_c(text):
    """Comments and string literals out, line structure kept."""
    out = []
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        if text.startswith("/*", i):
            j = text.find("*/", i + 2)
            j = n if j < 0 else j + 2
            out.append("\n" * text.count("\n", i, j))
            i = j
        elif text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j
        elif c in "\"'":
            j = i + 1
            while j < n and text[j] != c:
                j += 2 if text[j] == "\\" else 1
            out.append(c + c)
            i = j + 1
        else:
            out.append(c)
            i += 1
    return "".join(out)


TOKEN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")


class Headers:
    def __init__(self, files):
        self.tokens = set()
        self.members = {}
        self.embeds = {}
        self.protos = {}
        for f in files:
            with open(f) as fh:
                code = strip_c(fh.read())
            self.tokens.update(TOKEN.findall(code))
            self.read_structs(code)
            self.read_protos(code)

    def read_protos(self, code):
        # Everything at file scope up to a semicolon or an opening brace, with
        # the preprocessor lines gone. A brace after extern "C" is looked
        # through, and any other brace is a struct or a function body and is
        # skipped. What is left that looks like name(...) is a prototype.
        code = re.sub(r"(?m)^[ \t]*#(?:[^\n]*\\\n)*[^\n]*$", "", code)
        chunk = []
        depth = 0
        for c in code:
            if depth:
                depth += {"{": 1, "}": -1}.get(c, 0)
                continue
            if c == "{":
                text = "".join(chunk)
                if re.search(r'extern\s*""\s*$', text):
                    chunk = []
                    continue
                self.add_proto(text)
                chunk = []
                depth = 1
            elif c == ";":
                self.add_proto("".join(chunk))
                chunk = []
            elif c == "}":
                chunk = []
            else:
                chunk.append(c)

    def add_proto(self, text):
        text = strip_annotations(text).strip()
        if text.startswith("typedef"):
            return
        m = re.match(r"^(.*?)\b(\w+)\s*\((.*)\)\s*$", text, re.S)
        if not m or "=" in text or not m.group(1).strip():
            return
        ret = c_type(m.group(1))
        params = split_params(m.group(3))
        if params == ["void"]:
            params = []
        self.protos.setdefault(m.group(2), (ret, [c_param(x) for x in params]))

    def read_structs(self, code):
        # typedef struct Tag { ... } Name; and struct Name { ... };, with the
        # members being the last identifier of each declaration inside, or the
        # name inside (*name) for a function pointer. BURROW_FUNC and friends
        # are macros, so a member declared through one is found by its name
        # appearing at all, which is what the fallback below does. A vtable
        # member whose type is another vtable is Go's embedded interface, and
        # the methods of that one count as members of this one too.
        for m in re.finditer(r"\b(?:struct|union)\s+(\w+)?\s*\{", code):
            depth = 1
            i = m.end()
            while i < len(code) and depth:
                if code[i] == "{":
                    depth += 1
                elif code[i] == "}":
                    depth -= 1
                i += 1
            body = code[m.end() : i - 1]
            tail = re.match(r"\s*(\w+)\s*;", code[i:])
            names = [x for x in (m.group(1), tail.group(1) if tail else None) if x]
            members = set()
            embeds = set()
            for part in re.split(r";", re.sub(r"\{[^{}]*\}", " ", body)):
                fp = re.search(r"\(\s*\*\s*(\w+)\s*\)", part)
                if fp:
                    members.add(fp.group(1))
                    continue
                em = re.match(r"\s*(\w+VT)\s+\w+\s*$", part)
                if em:
                    embeds.add(em.group(1))
                ids = TOKEN.findall(re.sub(r"\[[^\]]*\]|:\s*\w+", " ", part))
                if ids:
                    members.add(ids[-1])
                # Several declarators on one line: Int a, b;
                for extra in re.findall(r",\s*\**\s*(\w+)", part):
                    members.add(extra)
            for name in names:
                self.members.setdefault(name, set()).update(members)
                self.embeds.setdefault(name, set()).update(embeds)

    def has(self, name):
        return name in self.tokens

    def has_member(self, owner, member, seen=None):
        if member in self.members.get(owner, ()):
            return True
        seen = seen or set()
        seen.add(owner)
        return any(
            self.has_member(e, member, seen) for e in self.embeds.get(owner, ()) if e not in seen
        )

    def proto(self, name):
        return self.protos.get(name)


def strip_annotations(text):
    """BURROW_OWNS(ret) and friends out, since they are not part of a type."""
    return re.sub(r"\bBURROW_[A-Z0-9_]+\s*(\([^()]*\))?", " ", text)


def split_params(text):
    out, depth, cur = [], 0, []
    for c in text:
        if c in "([":
            depth += 1
        elif c in ")]":
            depth -= 1
        if c == "," and depth == 0:
            out.append("".join(cur).strip())
            cur = []
        else:
            cur.append(c)
    last = "".join(cur).strip()
    if last or out:
        out.append(last)
    return out


# Qualifiers that say nothing about which type a value is. A const pointer is
# the right spelling for a parameter the function only reads, and Go has no way
# to say that, so the comparison ignores it.
QUALIFIERS = {"const", "volatile", "restrict", "static", "inline", "extern", "struct", "enum", "union"}


def c_type(text):
    """A C type as one canonical string: Int *, void, Slice."""
    words = [w for w in re.findall(r"\w+|\*", text) if w not in QUALIFIERS]
    base = " ".join(w for w in words if w != "*")
    stars = words.count("*")
    return base + (" " + "*" * stars if stars else "")


def c_param(text):
    """One parameter, with its name dropped."""
    if text == "...":
        return "..."
    if re.search(r"\(\s*\*", text):
        return "(*)"
    text = re.sub(r"\[[^\]]*\]\s*$", " *", text)
    words = [w for w in re.findall(r"\w+|\*", text) if w not in QUALIFIERS]
    # The last word is a name when something other than a star comes before it.
    names = [w for w in words if w != "*"]
    if len(names) > 1 and words[-1] != "*":
        words = words[:-1]
    return c_type(" ".join(words))


def header_files(paths):
    if paths:
        return paths
    return sorted(glob.glob(os.path.join(ROOT, "include", "burrow", "**", "*.h"), recursive=True))


# --------------------------------------------------------- the signatures

# What a Go builtin may be spelled as in C. The manifest has already turned
# byte into uint8 and rune into int32, so both spellings of those are right.
# Go's func types that burrow names once and uses everywhere, from
# burrow/func.h.
FUNC_TYPES = {
    "func(int32) bool": {"RuneFunc"},
    "func(int32) int32": {"RuneMapFunc"},
}

BUILTIN = {
    "bool": {"bool"},
    "string": {"Str"},
    "error": {"Error"},
    "int": {"Int"},
    "uint": {"Uint"},
    "uintptr": {"Uintptr", "uintptr_t"},
    "int8": {"int8_t"},
    "int16": {"int16_t"},
    "int32": {"int32_t", "Rune"},
    "int64": {"int64_t"},
    "uint8": {"uint8_t", "Byte"},
    "uint16": {"uint16_t"},
    "uint32": {"uint32_t"},
    "uint64": {"uint64_t"},
    "float32": {"float"},
    "float64": {"double"},
    "interface{}": {"Any"},
    "any": {"Any"},
}


def balanced(text, i):
    """The index just past the bracket group that starts at text[i]."""
    depth = 0
    for j in range(i, len(text)):
        if text[j] in "([{":
            depth += 1
        elif text[j] in ")]}":
            depth -= 1
            if depth == 0:
                return j + 1
    return len(text)


def go_list(text):
    """(A, B, func(C) D) into its parts, or a single result on its own."""
    text = text.strip()
    if not text:
        return []
    if not text.startswith("("):
        return [text]
    inner = text[1 : balanced(text, 0) - 1]
    return [x for x in split_params(inner) if x]


def go_signature(text):
    """The parameter and result lists of a manifest line's tail: (A, B) C."""
    end = balanced(text, 0)
    return go_list(text[:end]), go_list(text[end:])


class GoTypes:
    """Go types as the set of C spellings the rules allow, or None for any."""

    def __init__(self, packages):
        self.by_name = {}
        for path in packages:
            parts = path.split("/")
            name = parts[-2] if len(parts) > 1 and re.fullmatch(r"v[0-9]+", parts[-1]) else parts[-1]
            self.by_name.setdefault(name, []).append(path)

    def spell(self, path, t):
        t = t.strip()
        if t.startswith("...") or t.startswith("[]"):
            return {"Slice"}
        if t.startswith("*"):
            inner = self.spell(path, t[1:])
            if inner is None:
                return None
            return {e + "*" if e.endswith("*") else e + " *" for e in inner}
        if t.startswith("map["):
            return {"Map"}
        if re.match(r"^(<-)?chan\b", t):
            return {"Chan", "Chan *"}
        if t in FUNC_TYPES:
            return FUNC_TYPES[t]
        if t.startswith("func("):
            return {"Func", "(*)"}
        if t in BUILTIN:
            return BUILTIN[t]
        if t == "unsafe.Pointer":
            return {"void *"}
        m = re.fullmatch(r"(\w+)\.(\w+)", t)
        if m:
            paths = self.by_name.get(m.group(1), [])
            if len(paths) != 1:
                return None
            return {type_name(paths[0], m.group(2))}
        if re.fullmatch(r"[A-Z]\w*", t):
            return {type_name(path, t)}
        # Arrays, literal structs and interfaces, and type parameters, which
        # have no single spelling to hold a header to.
        return None


def fits(c, allowed):
    return allowed is None or c in allowed


def spelled(g, allowed):
    """Go's type and what it is in C: int, which is Int here."""
    return "%s, which is %s here" % (g, " or ".join(sorted(allowed))) if allowed else g


def check_signature(d, headers, gotypes):
    """None if the prototype has the shape the rules give it, or what is wrong."""
    if d.cname is None or d.renamed:
        return None
    proto = headers.proto(d.cname)
    if proto is None:
        return None
    # The manifest ends a line added after Go 1.0 with the proposal it came
    # from, as in #57928, which is not part of the type.
    text = re.sub(r"\s+#\d+$", "", d.text)
    m = re.match(r"^func \w+(\[[^\]]*\])?(\(.*)$", text)
    if m:
        if m.group(1):
            return None
        params, results = go_signature(m.group(2))
        receiver = False
    else:
        m = re.match(r"^method \((\*?)(\w+)(\[[^\]]*\])?\) \w+(\(.*)$", text)
        if not m:
            return None
        if m.group(3):
            return None
        params, results = go_signature(m.group(4))
        params = [m.group(1) + m.group(2)] + params
        receiver = True

    ret, cps = proto[0], list(proto[1])
    at = 1 if receiver else 0
    if len(cps) > at and cps[at] == "Alloc *":
        del cps[at]

    if len(results) >= 2 and results[-1] == "error":
        if not cps or cps[-1] != "Error *":
            return "the error result should be an Error * on the end"
        cps.pop()
        results = results[:-1]
    if not results:
        if ret not in ("void", "bool"):
            return "returns %s where Go returns nothing" % ret
    elif len(results) < 3 or not ret.endswith("Ret"):
        want = gotypes.spell(d.path, results[0])
        if not fits(ret, want):
            return "returns %s where Go returns %s" % (ret, spelled(results[0], want))
        for r in reversed(results[1:]):
            want = gotypes.spell(d.path, "*" + r)
            if not cps or not fits(cps[-1], want):
                return "the %s result should be a pointer on the end" % r
            cps.pop()

    if len(cps) != len(params):
        return "takes %d parameters where Go has %d" % (len(cps), len(params))
    for i, (c, g) in enumerate(zip(cps, params), 1):
        want = gotypes.spell(d.path, g)
        if not fits(c, want):
            return "parameter %d is %s where Go has %s" % (i, c, spelled(g, want))
    return None


# ------------------------------------------------------------- the lists


def read_list(path):
    if not os.path.exists(path):
        return []
    out = []
    with open(path) as fh:
        for n, line in enumerate(fh, 1):
            line = line.split("#", 1)[0].rstrip()
            if line.strip():
                out.append((n, line.strip()))
    return out


def read_waivers(path):
    """package: declaration: reason, where the declaration may be *."""
    waivers = {}
    for n, line in read_list(path):
        parts = [p.strip() for p in line.split(":", 2)]
        if len(parts) != 3 or not parts[2]:
            raise SystemExit("%s:%d: a waiver is package: declaration: reason" % (path, n))
        waivers[(parts[0], parts[1])] = parts[2]
    return waivers


# ------------------------------------------------------------ the report


def classify(d, headers, waivers, reshaped, gotypes):
    if (d.path, d.key) in waivers or (d.path, "*") in waivers:
        return "waived"
    if d.owner is not None:
        if headers.has_member(d.owner, d.member):
            return "renamed" if d.renamed else "present"
        if d.alternative and headers.has(d.alternative):
            return "present"
        return "missing"
    if not headers.has(d.cname):
        return "missing"
    d.why = check_signature(d, headers, gotypes)
    if d.why is not None:
        return "reshaped" if (d.path, d.key) in reshaped else "differs"
    return "renamed" if d.renamed else "present"


def c_spelling(d):
    if d.owner is not None:
        s = "%s.%s" % (d.owner, d.member)
        if d.alternative:
            s += " or " + d.alternative
        return s
    return d.cname


def main():
    p = argparse.ArgumentParser(prog=PROG, description="How much of Go's standard library burrow declares.")
    p.add_argument("packages", nargs="*", help="import paths, all public packages by default")
    p.add_argument("-v", "--verbose", action="store_true", help="every declaration and its C name")
    p.add_argument("--missing", action="store_true", help="only declarations that are missing")
    p.add_argument("--go-api", help="the directory with go1*.txt, $GOROOT/api by default")
    p.add_argument("--target", action="append", help="a platform to count, repeatable, the three release targets by default")
    p.add_argument("--header", action="append", help="a header to read, repeatable, include/burrow by default")
    p.add_argument("--done", default=os.path.join(HERE, "coverage-done.txt"), help="the finished packages")
    p.add_argument("--waivers", default=os.path.join(HERE, "coverage-waivers.txt"), help="the waived declarations")
    p.add_argument("--reshaped", default=os.path.join(HERE, "coverage-reshaped.txt"), help="the signatures that differ on purpose")
    p.add_argument("--no-gate", action="store_true", help="report only, never fail")
    args = p.parse_args()

    api_dir = args.go_api or os.path.join(goroot(), "api")
    decls = read_api(api_dir, args.target or TARGETS)
    headers = Headers(header_files(args.header))
    waivers = read_waivers(args.waivers)
    reshaped = read_waivers(args.reshaped)
    done = [line for _, line in read_list(args.done)]

    # A package can be public and declare nothing, like unsafe, whose contents
    # are builtins, or time/tzdata, which is imported for its side effect.
    public = public_packages()
    gotypes = GoTypes(public)
    packages = args.packages or public
    unknown = [pkg for pkg in packages + done if pkg not in decls and pkg not in public]
    if unknown:
        raise SystemExit("%s: not a public standard package: %s" % (PROG, " ".join(unknown)))

    # A declaration whose signature differs is counted with the missing ones,
    # since a caller written from Go's documentation cannot use it either.
    counted = {"renamed": "present", "reshaped": "present", "differs": "missing"}
    failed = []
    totals = {"present": 0, "missing": 0, "waived": 0, "differs": 0}
    width = max(len(pkg) for pkg in packages)
    for pkg in packages:
        counts = {"present": 0, "missing": 0, "waived": 0, "differs": 0}
        rows = []
        for d in decls.get(pkg, []):
            map_decl(d)
            d.status = classify(d, headers, waivers, reshaped, gotypes)
            counts[counted.get(d.status, d.status)] += 1
            if d.status == "differs":
                counts["differs"] += 1
            rows.append(d)
        for k in totals:
            totals[k] += counts[k]
        total = len(rows)
        want = total - counts["waived"]
        pct = 100.0 * counts["present"] / want if want else 100.0
        gated = pkg in done
        mark = ""
        if gated:
            mark = "done" if counts["missing"] == 0 else "FAIL"
            if counts["missing"]:
                failed.append(pkg)
        elif counts["present"] and not counts["missing"]:
            mark = "complete, not in the done list"
        elif counts["present"]:
            mark = "partial"
        extra = "  %d waived" % counts["waived"] if counts["waived"] else ""
        if counts["differs"]:
            extra += "  %d with the wrong signature" % counts["differs"]
        if not args.missing or counts["missing"]:
            print("%-*s %5d/%-5d %6.1f%%  %s%s" % (width, pkg, counts["present"], want, pct, mark, extra))
        if args.verbose or args.missing:
            for d in rows:
                if args.missing and d.status not in ("missing", "differs"):
                    continue
                print("    %-8s %-52s %s" % (d.status, d.text if len(d.text) <= 52 else d.key, c_spelling(d)))
                if d.why is not None and d.status in ("differs", "reshaped"):
                    print("    %-8s %s" % ("", d.why))

    want = totals["present"] + totals["missing"]
    print("-" * (width + 30))
    print(
        "%-*s %5d/%-5d %6.2f%%  %d packages, %d waived, %d with the wrong signature"
        % (width, "total", totals["present"], want, 100.0 * totals["present"] / want if want else 100.0, len(packages),
           totals["waived"], totals["differs"])
    )
    if failed and not args.no_gate:
        print(
            "\n%s: %s %s listed in %s and still missing declarations or getting signatures wrong. Add or fix them, "
            "waive a declaration in %s, or say why a signature differs in %s." % (
                PROG, " ".join(failed), "is" if len(failed) == 1 else "are", os.path.relpath(args.done),
                os.path.relpath(args.waivers), os.path.relpath(args.reshaped)),
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
