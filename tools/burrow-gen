    )
    r.add_argument(
        "--extra",
        action="append",
        default=[],
        metavar="FLAG",
        help="one more flag for the parser, repeatable",
    )

    m = sub.add_parser("amalgamate", help="the whole library as burrow.h and burrow.c")
    m.add_argument("--out", default="dist", help="the directory to write into, default dist")
    m.add_argument(
        "--source-id",
        default="unknown",
        help="what burrow_sourceid() returns, usually git describe, default unknown",
