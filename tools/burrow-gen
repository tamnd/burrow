    d.add_argument("--sync", action="store_true", help="rewrite the blocks from their programs")
    d.add_argument("--run", action="store_true", help="compile and run every program under docs/examples")
    d.add_argument("--sanitize", action="store_true", help="with --run, build under ASan and UBSan")
    d.add_argument("--cc", default=os.environ.get("CC", "cc"), help="the compiler for --run, default $CC or cc")
    d.add_argument("--root", metavar="DIR", help="the burrow tree to read, default the one this script is in")

    c = sub.add_parser("collisions", help="burrow's link names against other libraries' symbols")
    c.add_argument("libraries", nargs="*", help="libraries, or directories of them, to check against")
    c.add_argument("--burrow", action="append", metavar="LIB", help="burrow's built library, default build/libburrow.a")
    c.add_argument("--go-api", metavar="DIR", help="the directory with Go's go1*.txt, default $GOROOT/api")
    c.add_argument("--no-planned", action="store_true", help="check only the names burrow defines today")
    c.add_argument("--waivers", metavar="FILE", help="default tools/collision-waivers.txt")
    c.add_argument("--root", metavar="DIR", help="the burrow tree to read, default the one this script is in")

    args = p.parse_args()

    if args.command == "collisions":
        try:
            return run_collisions(args)
        except Error as e:
            sys.stderr.write("%s: %s\n" % (PROG, e))
            return 1

    if args.command == "doc":
        try:
            return run_doc(args)
        except Error as e:
            sys.stderr.write("%s: %s\n" % (PROG, e))
            return 1

    if args.command == "amalgamate":
        try:
            headers, sources = run_amalgamate(args)
        except Error as e:
            sys.stderr.write("%s: %s\n" % (PROG, e))
            return 1
        sys.stderr.write(
            "%s: %d headers and %d sources to %s\n" % (PROG, headers, sources, args.out)
        )
