#!/bin/sh
# The table of names a traceback prints instead of bare addresses.
#
# A panic that prints six hexadecimal numbers tells you where the program was
# and not what it was doing, and turning one into the other is symbolisation.
# Go's linker does it by emitting a table after it has decided what is in the
# binary. A C library has no linker of its own, so the table has to come from
# somewhere else, and the somewhere else is this: nm over the objects that were
# just compiled, one declaration and one array entry per function it found.
#
# WHY NM AND NOT THE SOURCE
#
# Reading the source with libclang would give file and line as well, which nm
# cannot. It would also give the answer for the machine the generator ran on,
# and a file compiled out by #if on that machine is a function that exists on
# the other two platforms and is missing from the table. Committing three tables
# and regenerating all of them whenever anybody adds a function is a tax on
# every pull request for the life of the project. The objects are the build that
# is actually happening, so a table read from them is right on every platform
# without anybody having to remember anything.
#
# What that costs is file and line. They arrive with the amalgamation, which is
# one translation unit that libclang can read exactly and where a static
# function can be named at all; see docs/design/06-runtime.md section 11.
#
# WHAT IT DOES NOT FIND
#
# Static functions, which is about a third of them. A static function has no
# name outside its own translation unit, so no other file can take its address,
# and this table is another file. They come back with the amalgamation for the
# same reason the line numbers do.
#
# Copyright 2026 The burrow Authors. All rights reserved.
# Use of this source code is governed by a BSD-style licence that can be found
# in the LICENSE file.

set -eu

out="-"
empty=0

while [ $# -gt 0 ]; do
	case "$1" in
	-o)
		out="$2"
		shift 2
		;;
	--empty)
		# What make passes for SYMTAB=0. The file is still produced and
		# still compiles, so nothing downstream has to know.
		empty=1
		shift
		;;
	--)
		shift
		break
		;;
	-*)
		printf 'burrow-symtab: unknown option %s\n' "$1" >&2
		exit 2
		;;
	*)
		break
		;;
	esac
done

# nm is in every toolchain that can produce the objects in the first place, so
# not having one means a cross build or a Windows shell, and neither is worth
# failing over. An empty table costs a traceback its names and nothing else.
if [ "$empty" -eq 0 ] && ! command -v nm >/dev/null 2>&1; then
	printf 'burrow-symtab: no nm, so a traceback will print addresses only\n' >&2
	empty=1
fi

names=""

if [ "$empty" -eq 0 ] && [ $# -gt 0 ]; then
	# Global text symbols, which is what a function that another file can name
	# looks like in every object format this runs on. The three field test is
	# what drops the undefined ones, whose lines are a U and a name with no
	# address in front of them.
	names=$(nm -g "$@" 2>/dev/null |
		awk 'NF == 3 && $2 == "T" { print $3 }' |
		sort -u)

	# Mach-O and 32 bit PE put an underscore in front of every C name and ELF
	# does not. Which of those this is could be read off uname, and then a cross
	# build would get it wrong, so it is read off the answer instead: burrow has
	# a function called burrow__callers and either it is in there with an
	# underscore or it is in there without one.
	if printf '%s\n' "$names" | grep -q '^_burrow__callers$'; then
		names=$(printf '%s\n' "$names" | sed 's/^_//')
	fi

	# Anything the toolchain put there rather than us. A burrow name never
	# starts with an underscore, and after the strip above neither does a name
	# that only had one because of the object format.
	names=$(printf '%s\n' "$names" | grep -v '^_' || true)
fi

count=$(printf '%s' "$names" | grep -c . || true)

emit() {
	cat <<'EOF'
/* Copyright 2026 The burrow Authors. All rights reserved.
 * Use of this source code is governed by a BSD-style licence that can be found
 * in the LICENSE file. */

/* Generated by tools/burrow-symtab. Do not edit, and do not commit.
 *
 * Two arrays and a count, which is what burrow/symtab.h says the table is.
 *
 * Every function below is declared here as taking nothing and returning
 * nothing, which is not what most of them are. That is deliberate and it is the
 * only thing that works: a table of every function in the library cannot spell
 * four hundred different prototypes without including four hundred headers, and
 * including them would drag in declarations that contradict these. Nothing is
 * ever called through these pointers. They are converted to an integer, sorted,
 * and compared against a program counter, and a function's address is the same
 * number whatever the compiler believes its arguments are.
 *
 * This file includes no burrow header on purpose, for the same reason: a header
 * that declared one of these functions properly would make the declaration
 * below a conflicting one, and the whole file would stop compiling. Everything
 * it needs is spelled in plain C. */

EOF

	if [ "$count" -eq 0 ]; then
		cat <<'EOF'
/* Nothing to put in it. A table of length zero still has to be an array of
 * something, because a C array cannot have no elements, so it is one null
 * pointer that the count says is not there. */
extern void (*const burrow__symbol_addrs[])(void);
extern const char *const burrow__symbol_names[];
extern const int burrow__symbol_count;

void (*const burrow__symbol_addrs[])(void) = {0};
const char *const burrow__symbol_names[] = {0};
const int burrow__symbol_count = 0;
EOF
		return
	fi

	printf '%s\n' "$names" | sed 's/^/void /; s/$/(void);/'
	printf '\n'

	printf 'extern void (*const burrow__symbol_addrs[])(void);\n'
	printf 'extern const char *const burrow__symbol_names[];\n'
	printf 'extern const int burrow__symbol_count;\n\n'

	printf 'void (*const burrow__symbol_addrs[])(void) = {\n'
	printf '%s\n' "$names" | sed 's/^/    /; s/$/,/'
	printf '};\n\n'

	printf 'const char *const burrow__symbol_names[] = {\n'
	printf '%s\n' "$names" | sed 's/^/    "/; s/$/",/'
	printf '};\n\n'

	printf 'const int burrow__symbol_count = %d;\n' "$count"
}

if [ "$out" = "-" ]; then
	emit
else
	emit >"$out"
fi

printf 'burrow-symtab: %d name%s\n' "$count" "$([ "$count" -eq 1 ] || printf s)" >&2
