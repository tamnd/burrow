# One formatter, no arguments about braces, and it runs in CI so the argument
# cannot restart. LLVM's style with four space indents and a wider column, which
# is close enough to what most C people already write that nobody has to learn
# anything.
---
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 88
PointerAlignment: Right
AlignAfterOpenBracket: Align
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AlwaysBreakAfterReturnType: None
BreakBeforeBraces: Attach
SpaceAfterCStyleCast: false
SortIncludes: CaseSensitive
IncludeBlocks: Preserve
# Comments are prose in this project and prose is reflowed by the person
# writing it, not by a tool that does not know where the sentence ends.
ReflowComments: false

# The ownership annotations sit in front of a declaration the way an attribute
# does, and without this clang-format treats them as the start of the return
# type and breaks the line in the middle of one.
AttributeMacros:
  - BURROW_OWNS
  - BURROW_BORROWS
  - BURROW_RETAINS
  - BURROW_STATIC
