PROG = "burrow-gen"

# ---------------------------------------------------------------- the model


class Field:
    def __init__(self, name, ctype, tag, where):
        self.name = name
        self.ctype = ctype
        self.tag = tag
        self.where = where


class Struct:
    def __init__(self, name, where):
        self.name = name
        self.where = where
        self.fields = []


class Error(Exception):
    """A problem with the input, reported with a file and a line."""


# TYPE_OF pastes its argument into an identifier, so a field's type has to be
# spellable as one. "Int" works, "struct Foo" and "char *" do not, and the
# answer to both is a typedef. This is the same restriction the DSL has, for
# the same reason, and saying so here beats a paste error in the output.
IDENTIFIER = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")

MARKER = re.compile(r"\bburrow:reflect\b")

TAG_PREFIX = "burrow:tag:"


# ------------------------------------------------------------- reading them


def annotations(lib, cursor):
    out = []
    for child in lib.children(cursor):
        if child.kind == CURSOR_ANNOTATE_ATTR:
            out.append(lib.cursor_spelling(child))
    return out


def is_marked(lib, cursor):
    comment = lib.raw_comment(cursor)
    if comment and MARKER.search(comment):
        return True
    return any(MARKER.search(a) for a in annotations(lib, cursor))


def tag_of(lib, cursor):
    for a in annotations(lib, cursor):
        if a.startswith(TAG_PREFIX):
            return a[len(TAG_PREFIX) :]
    return ""


def read_struct(lib, typedef, record, name):
    where = lib.location(typedef)
    s = Struct(name, where)

    for child in lib.children(record):
        if child.kind != CURSOR_FIELD_DECL:
            continue

        at = lib.location(child)
        fname = lib.cursor_spelling(child)

        if not fname:
            raise Error(
                "%s: an anonymous member of %s. offsetof needs a name, so give "
                "it one or leave the struct out." % (at, name)
            )

        if lib.is_bitfield(child):
            raise Error(
                "%s: %s.%s is a bit field. A bit field has no address and so no "
                "offsetof, which means no descriptor can describe it."
                % (at, name, fname)
            )

        ctype = lib.type_spelling(lib.cursor_type(child))

        if not IDENTIFIER.match(ctype):
            raise Error(
                "%s: %s.%s is a %s, which is not spellable as one identifier. "
                "TYPE_OF pastes its argument into a name, so give the type a "
                "typedef and use that." % (at, name, fname, ctype)
            )

        s.fields.append(Field(fname, ctype, tag_of(lib, child), at))

    if not s.fields:
        raise Error("%s: %s has no fields, so there is nothing to describe." % (where, name))

    return s


def collect(lib, tu, wanted):
    """Every marked struct declared in one of the files we were asked about."""
    found = []
    marked_records = []
    used_records = []

    # A marked struct in a header this one included is that header's business,
    # not ours. Run the generator on it separately if you want its descriptors,
    # so that two runs never emit the same one twice.
    top = [c for c in lib.children(lib.tu_cursor(tu)) if lib.file_of(c) in wanted]

    for cursor in top:
        if cursor.kind == CURSOR_STRUCT_DECL and is_marked(lib, cursor):
            marked_records.append(cursor)

        if cursor.kind != CURSOR_TYPEDEF_DECL:
            continue

        where = lib.location(cursor)
        record = lib.type_declaration(lib.typedef_underlying(cursor))

        # For "typedef struct { ... } Point;" the comment attaches to the
        # anonymous record and for "typedef ... Point BURROW_REFLECT;" the
        # attribute is on the typedef, so ask both rather than depending on
        # which shape somebody used.
        if not (is_marked(lib, cursor) or is_marked(lib, record)):
            continue

        if record.kind != CURSOR_STRUCT_DECL:
            raise Error(
                "%s: burrow:reflect on %s, which is not a struct. Only structs "
                "have fields to describe." % (where, lib.cursor_spelling(cursor))
            )

        used_records.append(record)
        found.append(read_struct(lib, cursor, record, lib.cursor_spelling(cursor)))

    # A marked struct with no typedef over it is reachable only as "struct Foo",
    # which is two tokens, so no descriptor could be named after it.
    for record in marked_records:
        if any(lib.same_cursor(record, used) for used in used_records):
            continue
        raise Error(
            "%s: burrow:reflect on struct %s, which has no typedef. TYPE_OF "
            "needs a single identifier, so add one."
            % (lib.location(record), lib.cursor_spelling(record) or "(anonymous)")
        )

    return found


# ------------------------------------------------------------- writing them


def c_string(s):
    """A C string literal for s, escaped so the compiler reads back what we saw."""
    out = ['"']
    for ch in s:
        if ch == "\\":
            out.append("\\\\")
        elif ch == '"':
            out.append('\\"')
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\t":
            out.append("\\t")
        elif " " <= ch <= "~":
            out.append(ch)
        else:
            # Anything else goes out as bytes, because a tag is bytes and the
            # encoding of the source file is not our business.
            for b in ch.encode("utf-8"):
                out.append("\\%03o" % b)
    out.append('"')
    return "".join(out)


def guard_of(path):
    name = re.sub(r"[^A-Za-z0-9]", "_", os.path.basename(path)).upper()
    return "BURROW_GEN_" + name


def emit_header(structs, includes, banner, path):
    """The externs, so a descriptor can be reached from another file.

    The DSL's DECL form puts these in your header for the same reason: TYPE_OF
    is an address-of on a name, and a name has to be declared before another
    translation unit's static initialiser can take its address.
    """
    w = []
    if banner:
        w.append(banner.rstrip("\n"))
        w.append("")

    guard = guard_of(path)
    w.append("/* Generated by %s reflect. Do not edit. */" % PROG)
    w.append("")
    w.append("#ifndef %s" % guard)
    w.append("#define %s" % guard)
    w.append("")
    w.append('#include "burrow/type.h"')
    w.append("")
    for inc in includes:
        w.append('#include "%s"' % inc)
    w.append("")
    for s in structs:
        w.append("extern const Type burrow_type_%s;" % s.name)
    w.append("")
    w.append("#endif /* %s */" % guard)
    return "\n".join(w)


def emit(structs, includes, banner, register, header):
    w = []
    if banner:
        w.append(banner.rstrip("\n"))
        w.append("")

    w.append("/* Generated by %s reflect. Do not edit." % PROG)
    w.append(" *")
    w.append(" * Edit the annotated structs and run the generator again. The offsets and")
    w.append(" * sizes are left as offsetof and sizeof on purpose, so that the compiler")
    w.append(" * building for your target is the one that works them out. */")
    w.append("")
    w.append('#include "burrow/declare.h"')
    w.append('#include "burrow/type.h"')
    w.append("")
    w.append("#include <stddef.h>")
    w.append("#include <stdint.h>")
    w.append("")
    if header:
        w.append('#include "%s"' % os.path.basename(header))
    for inc in includes:
        w.append('#include "%s"' % inc)
    w.append("")

    for s in structs:
        w.append("/* %s, from %s */" % (s.name, s.where))
        w.append("static const Field burrow__fields_%s[] = {" % s.name)
        for f in s.fields:
            w.append("    {")
            w.append("        BURROW_S_INIT(%s)," % c_string(f.name))
            w.append("        BURROW_S_INIT(%s)," % c_string(f.tag))
            w.append("        TYPE_OF(%s)," % f.ctype)
            w.append("        (uint32_t)offsetof(%s, %s)," % (s.name, f.name))
            w.append("    },")
        w.append("};")
        w.append("")
        # Only when there is no generated header carrying it, because two
        # declarations of one object is what -Wredundant-decls is about.
        if not header:
            w.append("extern const Type burrow_type_%s;" % s.name)
            w.append("")
        w.append("const Type burrow_type_%s = {" % s.name)
        w.append("    BURROW_S_INIT(%s)," % c_string(s.name))
        w.append("    {NULL, 0},")
        w.append("    KIND_STRUCT,")
        w.append("    (uint32_t)sizeof(%s)," % s.name)
        w.append("    (uint16_t)_Alignof(%s)," % s.name)
        w.append(
            "    (uint16_t)(sizeof burrow__fields_%s / sizeof burrow__fields_%s[0]),"
            % (s.name, s.name)
        )
        w.append("    0,")
        w.append("    burrow__fields_%s," % s.name)
        w.append("    NULL,")
        w.append("    NULL,")
        w.append("    NULL,")
        w.append("    0,")
        w.append("    0,")
        w.append("    NULL,")
        w.append("};")
        if register:
            w.append("")
            w.append("BURROW_REGISTER_TYPE(%s);" % s.name)
        w.append("")

    return "\n".join(w)


# ------------------------------------------------------------------- driver


def run_reflect(args):
    lib = LibClang(args.libclang)

    argv = ["-x", "c", "-std=" + args.std, "-fparse-all-comments", "-DBURROW_GEN=1"]
    argv += ["-I" + d for d in args.include_dir]
    argv += ["-D" + d for d in args.define]
    argv += lib.toolchain_flags(args.extra)
    argv += args.extra

    wanted = set(os.path.realpath(h) for h in args.headers)
    structs = []

    for header in args.headers:
        tu = lib.parse(header, argv)
        structs += collect(lib, tu, wanted)
        lib.dispose(tu)

    if not structs:
        raise Error(
            "no struct marked burrow:reflect in %s. The marker is a "
            "/* burrow:reflect */ comment on the typedef, or BURROW_REFLECT on it."
            % ", ".join(args.headers)
        )

    seen = {}
    for s in structs:
        if s.name in seen:
            raise Error(
                "%s: %s is marked here and at %s. Two descriptors with one name "
                "will not link." % (s.where, s.name, seen[s.name])
            )
        seen[s.name] = s.where

    includes = args.include_as or [os.path.basename(h) for h in args.headers]

    banner = ""
    if args.banner:
        with open(args.banner, "r") as f:
            banner = f.read()

    if args.header:
        with open(args.header, "w") as f:
            f.write(emit_header(structs, includes, banner, args.header) + "\n")

    text = emit(structs, includes, banner, args.register, args.header) + "\n"

    if args.output == "-":
        sys.stdout.write(text)
    else:
        with open(args.output, "w") as f:
            f.write(text)

    return len(structs)


# ------------------------------------------------------------ amalgamate
#
# burrow.h and burrow.c: the whole library as one header and one source file,
# the way SQLite ships. The tree stays the tree, one file per Go file, and this
# is generated from it every time and never edited, so the two cannot drift.
#
# What it has to get right is small and all of it is about making many
# translation units into one without changing what any of them means:
#
#   - Every burrow header is pasted once, dependencies first, and each
#     #include of one is blanked where it was. The public ones, the closure of
#     burrow/burrow.h, go in burrow.h. The rest go at the top of burrow.c.
#   - A source file's feature macros, the _GNU_SOURCE block before its first
#     #include, have to come before every system header in the whole file, so
#     they are lifted to the top of burrow.c. The first file to define one wins.
#   - A macro a source file defines is its own, so it is undefined again at the
#     end of that file. tools/check-statics.sh keeps every other file scope name
#     unique, which is the rest of what one translation unit needs.
#   - Every pasted file starts with a #line, and a line that is taken out is
#     replaced by an empty comment rather than removed, so one #line per file
#     is enough for every diagnostic, __FILE__ and debugger to name the real
#     file and the real line.
#
# The output depends on the input files and on nothing else: no dates, no
# paths from the machine it ran on, files in sorted order. Two runs on the same
# tree give the same bytes, and CI checks that.
#
# PACKAGES
#
# A header that is the public face of a Go package says so on a line of its own:
#
#     /* burrow:package unicode/utf8 */
#
# A source file belongs to the package of the first burrow header it includes,
# which the tree's convention already makes its own header. Files under the core
# directories belong to no package, and neither does anything a package header
# does not claim. That is the core, and it is always in.
#
# What a package needs is read off the include graph: every package whose header
# its files reach. The core needs some packages too, because the runtime uses
# sync and time, so those are always in and cannot be left out.
#
# --packages keeps the named packages and everything they need, and drops the
# rest from both files. Whatever can still be dropped is wrapped in
# BURROW_OMIT_<PACKAGE>, the import path in capitals with the slashes turned into
# underscores, so a full burrow.c can be trimmed from the compiler command line
# too. burrow.h checks the combination up front, so leaving out a package that a
# kept one needs is an #error that says which, rather than a link error later.

AMALG_INCLUDE = re.compile(r'^\s*#\s*include\s+"(burrow/[^"]+|[a-z0-9_]+\.h)"')
AMALG_DEFINE = re.compile(r"^\s*#\s*define\s+([A-Za-z_][A-Za-z0-9_]*)")
AMALG_ANY_INCLUDE = re.compile(r"^\s*#\s*include\b")
AMALG_DIRECTIVE = re.compile(r"^\s*#")
AMALG_VERSION = re.compile(r'#define\s+BURROW_VERSION_STRING\s+"([^"]+)"')
AMALG_PACKAGE = re.compile(r"^/\*\s*burrow:package\s+([a-z0-9_/]+)\s*\*/\s*$")
AMALG_CORE_DIRS = ("core", "mem", "pal", "runtime")
AMALG_UMBRELLA = "include/burrow/burrow.h"


class Amalgamation:
    def __init__(self, root):
        self.root = root
        self.inputs = {}

    def read(self, rel):
        with open(os.path.join(self.root, rel), "rb") as f:
            data = f.read()
        self.inputs[rel] = hashlib.sha256(data).hexdigest()
        return data.decode("utf-8").split("\n")

    def files(self, top, suffix):
        out = []
        for d, dirs, names in os.walk(os.path.join(self.root, top)):
            dirs.sort()
            for n in sorted(names):
                if n.endswith(suffix):
                    out.append(os.path.relpath(os.path.join(d, n), self.root).replace(os.sep, "/"))
        return sorted(out)


def amalg_header_path(name, includer):
    """Where an #include points. A name with no directory is a header private to
    the directory of the file that includes it, as src/fmt/format.h is to the
    files in src/fmt."""
    if "/" not in name:
        return os.path.dirname(includer) + "/" + name
    return "include/" + name


def amalg_order(start, lines_of, skip=()):
    """Headers in an order where each comes after everything it includes.

    Depth first over the #include lines in the order they are written, which is
    deterministic and keeps related headers next to each other. Headers in skip
    are left out, along with anything only they include."""
    order = []
    state = {}

    def visit(path, via):
        if path in skip or state.get(path) == "done":
            return
        if state.get(path) == "open":
            raise Error("%s includes itself through %s" % (path, " -> ".join(via)))
        state[path] = "open"
        for line in lines_of(path):
            m = AMALG_INCLUDE.match(line)
            if m:
                visit(amalg_header_path(m.group(1), path), via + [path])
        state[path] = "done"
        order.append(path)

    for s in start:
        visit(s, [])
    return order


def amalg_blank(line):
    """What a line that was taken out becomes, so the line count stays true."""
    return "/* burrow-gen: %s */" % line.strip().replace("*/", "* /")


def amalg_paste(out, rel, lines, omit=None):
    if lines and lines[-1] == "":
        lines = lines[:-1]
    out.append("/* ==== begin %s ==== */" % rel)
    if omit:
        out.append("#if !defined(%s)" % omit)
    out.append('#line 1 "%s"' % rel)
    out.extend(lines)
    if omit:
        out.append("#endif /* %s */" % omit)
    out.append("/* ==== end %s ==== */" % rel)
    out.append("")


def amalg_omit_macro(pkg):
    return "BURROW_OMIT_" + pkg.upper().replace("/", "_")


class Packages:
    """Which package each file is in and which packages each one needs."""

    def __init__(self, headers, sources, lines_of):
        self.owner = {}
        for h in headers:
            for line in lines_of(h):
                m = AMALG_PACKAGE.match(line)
                if not m:
                    continue
                if h in self.owner:
                    raise Error("%s has two burrow:package lines" % h)
                self.owner[h] = m.group(1)
        # A header private to a package's directory belongs to the package the
        # same way the directory's sources do, by the first header it includes.
        private = [h for h in headers if h.startswith("src/") and h not in self.owner]
        for s in private + list(sources):
            parts = s.split("/")
            core = len(parts) == 2 or parts[1] in AMALG_CORE_DIRS
            first = None
            for line in lines_of(s):
                m = AMALG_INCLUDE.match(line)
                if m:
                    first = amalg_header_path(m.group(1), s)
                    break
            if core:
                continue
            if first not in self.owner:
                raise Error(
                    "%s is outside the core directories, so it is part of a package, "
                    "and the first burrow header it includes is %s, which has no "
                    "burrow:package line" % (s, first or "none")
                )
            self.owner[s] = self.owner[first]

        self.names = sorted(set(self.owner.values()))
        reached = {}

        def reach(rel):
            if rel not in reached:
                reached[rel] = set()
                out = set()
                for line in lines_of(rel):
                    m = AMALG_INCLUDE.match(line)
                    if m:
                        h = amalg_header_path(m.group(1), rel)
                        if h != AMALG_UMBRELLA:
                            out.add(h)
                            out |= reach(h)
                reached[rel] = out
            return reached[rel]

        self.needs = {p: set() for p in self.names}
        core_needs = set()
        for f in list(headers) + list(sources):
            if f == AMALG_UMBRELLA:
                continue
            got = set(self.owner[h] for h in reach(f) if h in self.owner)
            p = self.owner.get(f)
            if p is None:
                core_needs |= got
            else:
                self.needs[p] |= got - {p}
        self.required = self.closure(core_needs)

    def closure(self, start):
        out = set(start)
        todo = sorted(out)
        while todo:
            for q in sorted(self.needs[todo.pop()]):
                if q not in out:
                    out.add(q)
                    todo.append(q)
        return out

    def select(self, wanted):
        """The packages to keep for a --packages list, or all of them for None."""
        if wanted is None:
            return set(self.names)
        for p in wanted:
            if p not in self.names:
                raise Error(
                    "there is no package called %s. The packages are %s"
                    % (p, ", ".join(self.names))
                )
        return self.closure(set(wanted) | self.required)

    def checks(self, keep):
        """The #error lines that refuse a BURROW_OMIT_ combination that cannot link."""
        out = []
        for p in sorted(self.required):
            out.append("#if defined(%s)" % amalg_omit_macro(p))
            out.append(
                '#error "%s is set, and the runtime uses %s, so it cannot be left out"'
                % (amalg_omit_macro(p), p)
            )
            out.append("#endif")
        for p in sorted(keep - self.required):
            for q in sorted(self.needs[p] - self.required):
                out.append(
                    "#if defined(%s) && !defined(%s)" % (amalg_omit_macro(q), amalg_omit_macro(p))
                )
                out.append(
                    '#error "%s is set, and %s uses %s, so leave %s out as well or keep %s"'
                    % (amalg_omit_macro(q), p, q, p, q)
                )
                out.append("#endif")
        return out


def amalg_prologue(rel, lines):
    """Split a source file into its feature macro prologue and the rest.

    The prologue is every directive before the first #include. They are the
    lines that decide what the system headers declare, so they are only
    meaningful ahead of all of them."""
    lifted = []
    body = list(lines)
    for i, line in enumerate(lines):
        if AMALG_ANY_INCLUDE.match(line):
            break
        if AMALG_DIRECTIVE.match(line):
            lifted.append(line)
            body[i] = amalg_blank(line)
    return lifted, body


def amalg_guard_defines(lifted):
    """The same directives, with each #define made to give way to one before it."""
    out = []
    for line in lifted:
        m = AMALG_DEFINE.match(line)
        if m:
            out.append("#if !defined(%s)" % m.group(1))
            out.append(line.strip())
            out.append("#endif")
        else:
            out.append(line.strip())
    return out


def run_amalgamate(args):
    root = args.root or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    a = Amalgamation(root)
    cache = {}

    def lines_of(rel):
        if rel not in cache:
            if not os.path.exists(os.path.join(root, rel)):
                raise Error("%s is included and does not exist" % rel)
            cache[rel] = a.read(rel)
        return cache[rel]

    version = None
    for line in lines_of("include/burrow/version.h"):
        m = AMALG_VERSION.search(line)
        if m:
            version = m.group(1)
    if version is None:
        raise Error("include/burrow/version.h has no BURROW_VERSION_STRING")

    all_headers = amalg_order(
        [AMALG_UMBRELLA] + a.files("include", ".h") + a.files("src", ".h"), lines_of
    )
    all_sources = a.files("src", ".c")
    pk = Packages(all_headers, all_sources, lines_of)
    wanted = getattr(args, "packages", None)
    if wanted is not None:
        wanted = [p.strip() for p in wanted.split(",") if p.strip()]
    keep = pk.select(wanted)
    skip = set(f for f, p in pk.owner.items() if p not in keep)

    def omit_of(rel):
        p = pk.owner.get(rel)
        return amalg_omit_macro(p) if p is not None and p not in pk.required else None

    public = amalg_order([AMALG_UMBRELLA], lines_of, skip)
    everything = amalg_order(
        public + a.files("include", ".h") + a.files("src", ".h"), lines_of, skip
    )
    private = [h for h in everything if h not in public]
    sources = [s for s in all_sources if s not in skip]

    header_macros = set()
    for h in everything:
        for line in lines_of(h):
            m = AMALG_DEFINE.match(line)
            if m:
                header_macros.add(m.group(1))

    def strip_includes(lines):
        return [amalg_blank(l) if AMALG_INCLUDE.match(l) else l for l in lines]

    banner = [
        "/* burrow %s, amalgamated." % version,
        " *",
        " * Generated by tools/burrow-gen amalgamate from the burrow source tree. Do",
        " * not edit it: change the tree and generate it again. Every file starts with",
        " * a #line pointing back at where it came from, so a compiler error or a",
        " * debugger names the real file. burrow-manifest.json beside this lists the",
        " * inputs and their SHA-256.",
        " *",
        " * Copyright 2026 The burrow Authors. All rights reserved.",
        " * Use of this source code is governed by a BSD-style licence that can be",
        " * found in the LICENSE file at https://github.com/tamnd/burrow. */",
        "",
    ]

    # burrow.h
    h = list(banner)
    h.append("#ifndef BURROW_AMALGAMATION_H")
    h.append("#define BURROW_AMALGAMATION_H")
    h.append("")
    h.append("/* ==== the packages in this file ==== */")
    h.append("")
    h.append("/* %s." % ", ".join(sorted(keep)))
    h.append(" *")
    h.append(" * Define BURROW_OMIT_ and a package's import path, in capitals with the")
    h.append(" * slashes as underscores, to leave that package out of the build. Define it")
    h.append(" * for burrow.c and for every file that includes this, which in practice")
    h.append(" * means on the compiler command line. The checks below refuse a combination")
    h.append(" * that leaves out something a remaining package needs. */")
    h.extend(pk.checks(keep))
    h.append("")
    for rel in public:
        amalg_paste(h, rel, strip_includes(lines_of(rel)), omit_of(rel))
    h.append("#endif /* BURROW_AMALGAMATION_H */")
    h.append("")

    # burrow.c
    c = list(banner)
    c.append("/* ==== feature macros, lifted from the top of each source file ==== */")
    c.append("")
    bodies = []
    for rel in sources:
        lifted, body = amalg_prologue(rel, lines_of(rel))
        if lifted:
            c.append("/* %s */" % rel)
            c.extend(amalg_guard_defines(lifted))
            c.append("")
        bodies.append((rel, body))

    c.append("#ifndef BURROW_SOURCE_ID")
    c.append('#define BURROW_SOURCE_ID "%s"' % c_string(args.source_id)[1:-1])
    c.append("#endif")
    c.append("")
    c.append('#include "burrow.h"')
    c.append("")
    # A header's static inline helpers are there for whichever files want them,
    # and a compiler says nothing about the ones a file does not use, because
    # they came from a header. Pasted in here they are in the main file, where
    # an unused static function is a warning. The warning is right about a .c
    # and wrong about these, so it is off for exactly this stretch.
    c.append("#if defined(__GNUC__)")
    c.append("#pragma GCC diagnostic push")
    c.append('#pragma GCC diagnostic ignored "-Wunused-function"')
    c.append("#endif")
    c.append("")
    for rel in private:
        amalg_paste(c, rel, strip_includes(lines_of(rel)), omit_of(rel))
    c.append("#if defined(__GNUC__)")
    c.append("#pragma GCC diagnostic pop")
    c.append("#endif")
    c.append("")

    for rel, body in bodies:
        own = []
        for line in body:
            m = AMALG_DEFINE.match(line)
            if not m:
                continue
            name = m.group(1)
            if name in header_macros:
                raise Error(
                    "%s defines %s, which a header defines too. The amalgamation "
                    "undefines a source file's macros at the end of it, and that "
                    "would take the header's away from every file after it." % (rel, name)
                )
            if name not in own:
                own.append(name)
        amalg_paste(c, rel, strip_includes(body), omit_of(rel))
        if own:
            c.extend("#undef %s" % name for name in own)
            c.append("")

    c.extend(
        [
            "/* ==== the symbol table ==== */",
            "",
            "/* The names a traceback prints are a table built from the compiled",
            " * library, which a single file cannot contain before it is compiled. So",
            " * the amalgamation has an empty one, and a traceback prints addresses",
            " * that addr2line or atos can turn into names. A build that makes its own",
            " * table with tools/burrow-symtab defines BURROW_EXTERNAL_SYMTAB. */",
            "#if !defined(BURROW_EXTERNAL_SYMTAB)",
            "void (*const burrow__symbol_addrs[])(void) = {0};",
            "const char *const burrow__symbol_names[] = {0};",
            "const int burrow__symbol_count = 0;",
            "#endif",
            "",
        ]
    )

    htext = "\n".join(h)
    ctext = "\n".join(c)

    manifest = {
        "version": version,
        "source_id": args.source_id,
        "packages": sorted(keep),
        "targets": "all",
        "inputs": a.inputs,
        "outputs": {
            "burrow.h": hashlib.sha256(htext.encode("utf-8")).hexdigest(),
            "burrow.c": hashlib.sha256(ctext.encode("utf-8")).hexdigest(),
        },
    }
    mtext = json.dumps(manifest, indent=2, sort_keys=True) + "\n"

    os.makedirs(args.out, exist_ok=True)
    for name, text in (("burrow.h", htext), ("burrow.c", ctext), ("burrow-manifest.json", mtext)):
        with open(os.path.join(args.out, name), "w", newline="\n") as f:
            f.write(text)

    return len(public) + len(private), len(sources)


# ------------------------------------------------------------------------ doc

DOC_MARK = re.compile(r"^<!--\s*(example|not compiled):\s*(.*?)\s*-->\s*$")
DOC_FENCE = re.compile(r"^```(\S*)(.*)$")
DOC_REGION = re.compile(r"^\s*//\s*doc:\s*(\S+)\s*$")
DOC_OUTPUT = re.compile(r"/\*\s*Output:\s*\n(.*?)\*/\s*$", re.S)


class DocBlock:
    def __init__(self, md, start, end, lang, info, mark, arg):
        self.md = md
        self.start = start  # index of the opening fence
        self.end = end  # index of the closing fence
        self.lang = lang
        self.info = info
        self.mark = mark
        self.arg = arg


def doc_blocks(md, lines):
    """Every fenced block in a markdown file, with the comment before it."""
    out = []
    i = 0
    while i < len(lines):
        m = DOC_FENCE.match(lines[i])
        if not m:
            i += 1
            continue
        j = i + 1
        while j < len(lines) and not lines[j].startswith("```"):
            j += 1
        if j == len(lines):
            raise Error("%s:%d: a code block that is never closed" % (md, i + 1))
        mark = arg = None
        if i > 0:
            c = DOC_MARK.match(lines[i - 1])
            if c:
                mark, arg = c.group(1), c.group(2)
        out.append(DocBlock(md, i, j, m.group(1), m.group(2).strip(), mark, arg))
        i = j + 1
    return out


def doc_region(path, name):
    """The lines of a program a block shows: all of it, or one named region."""
    if not os.path.exists(path):
        raise Error("%s does not exist" % path)
    with open(path) as f:
        lines = f.read().split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    if name is None:
        return [l for l in lines if not DOC_REGION.match(l)]
    got = None
    for n, l in enumerate(lines):
        m = DOC_REGION.match(l)
        if not m:
            if got is not None:
                got.append(l)
            continue
        if got is None and m.group(1) == name:
            got = []
        elif got is not None and m.group(1) == "end":
            body = "\n".join(got)
            return textwrap.dedent(body).split("\n") if body else []
        elif got is not None:
            raise Error("%s:%d: region %s is not ended before the next one starts" % (path, n + 1, name))
        continue
    if got is None:
        raise Error("%s has no region called %s" % (path, name))
    raise Error("%s: region %s is never ended with // doc: end" % (path, name))


def doc_markdown_files(root):
    files = sorted(glob.glob(os.path.join(root, "docs", "**", "*.md"), recursive=True))
    files += [os.path.join(root, f) for f in ("README.md", "CONTRIBUTING.md") if os.path.exists(os.path.join(root, f))]
    return files


def doc_checked(root, problems):
    path = os.path.join(root, "docs", "examples", "checked.txt")
    out = set()
    if os.path.exists(path):
        with open(path) as f:
            for n, line in enumerate(f, 1):
                line = line.split("#", 1)[0].strip()
                if not line:
                    continue
                full = os.path.normpath(os.path.join(root, line))
                # A name that points at nothing would switch the check off for
                # the guide it meant without anybody noticing, which is exactly
                # what happened to five guides before this line existed.
                if not os.path.isfile(full):
                    problems.append("docs/examples/checked.txt:%d: %s is not a file, paths are from the top of the repository" % (n, line))
                out.add(full)
    return out


def doc_check(root, sync):
    problems = []
    checked = doc_checked(root, problems)
    blocks = 0
    rewritten = 0
    for md in doc_markdown_files(root):
        rel = os.path.relpath(md, root)
        with open(md) as f:
            lines = f.read().split("\n")
        changed = False
        # Walk backwards so a rewrite does not move the blocks still to come.
        for b in reversed(doc_blocks(rel, lines)):
            if b.lang == "c" and b.info:
                problems.append("%s:%d: text after ```c on the fence, which ends up in the block's language" % (rel, b.start + 1))
            if b.mark == "not compiled":
                if not b.arg:
                    problems.append("%s:%d: say why the block is not compiled" % (rel, b.start))
                continue
            if b.mark != "example":
                if b.lang == "c" and os.path.normpath(md) in checked:
                    problems.append("%s:%d: a C block with no example comment before it" % (rel, b.start + 1))
                continue
            blocks += 1
            target, _, name = b.arg.partition("#")
            path = os.path.normpath(os.path.join(os.path.dirname(md), target))
            try:
                want = doc_region(path, name or None)
            except Error as e:
                problems.append("%s:%d: %s" % (rel, b.start, e))
                continue
            have = lines[b.start + 1 : b.end]
            if have == want:
                continue
            if sync:
                lines[b.start + 1 : b.end] = want
                changed = True
                rewritten += 1
            else:
                problems.append("%s:%d: the block is not what %s says, run burrow-gen doc --sync" % (rel, b.start + 1, b.arg))
        if changed:
            with open(md, "w") as f:
                f.write("\n".join(lines))
    return blocks, rewritten, problems


def doc_run(root, cc, sanitize):
    import shutil
    import subprocess
    import tempfile

    examples = sorted(glob.glob(os.path.join(root, "docs", "examples", "**", "*.c"), recursive=True))
    if not examples:
        return 0, []
    tmp = tempfile.mkdtemp(prefix="burrow-doc-")
    try:
        ns = argparse.Namespace(out=tmp, source_id="docs", root=root)
        run_amalgamate(ns)
        inc = os.path.join(tmp, "include")
        for h in glob.glob(os.path.join(root, "include", "burrow", "**", "*.h"), recursive=True):
            rel = os.path.relpath(h, os.path.join(root, "include"))
            shim = os.path.join(inc, rel)
            os.makedirs(os.path.dirname(shim), exist_ok=True)
            with open(shim, "w") as f:
                f.write('#include "%s"\n' % os.path.relpath(os.path.join(tmp, "burrow.h"), os.path.dirname(shim)))
        flags = ["-std=c11", "-O1", "-g", "-pthread"]
        if sanitize:
            flags += ["-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-fno-sanitize-recover=all"]
        obj = os.path.join(tmp, "burrow.o")
        r = subprocess.run([cc] + flags + ["-c", os.path.join(tmp, "burrow.c"), "-o", obj], capture_output=True, text=True)
        if r.returncode:
            return 0, ["the amalgamation does not compile:\n" + r.stderr]
        warn = ["-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter"]
        problems = []
        work = os.path.join(tmp, "work")
        for ex in examples:
            # Each program starts in an empty directory of its own, so one that
            # makes files can make them without cleaning up after itself.
            shutil.rmtree(work, ignore_errors=True)
            os.makedirs(work)
            rel = os.path.relpath(ex, root)
            exe = os.path.join(tmp, "ex")
            r = subprocess.run(
                [cc] + flags + warn + ["-I" + inc, "-I" + tmp, ex, obj, "-lm", "-o", exe],
                capture_output=True,
                text=True,
            )
            if r.returncode:
                problems.append("%s does not compile:\n%s" % (rel, r.stderr.rstrip()))
                continue
            try:
                r = subprocess.run([exe], capture_output=True, text=True, timeout=60, cwd=work)
            except subprocess.TimeoutExpired:
                problems.append("%s did not finish in a minute" % rel)
                continue
            if r.returncode:
                problems.append("%s exited %d:\n%s" % (rel, r.returncode, (r.stdout + r.stderr).rstrip()))
                continue
            with open(ex) as f:
                m = DOC_OUTPUT.search(f.read())
            if m:
                want = [l.rstrip() for l in m.group(1).rstrip().split("\n")]
                got = [l.rstrip() for l in r.stdout.rstrip().split("\n")] if r.stdout.strip() else []
                if want == [""]:
                    want = []
                if got != want:
                    problems.append(
                        "%s printed something else.\nwant:\n%s\ngot:\n%s" % (rel, "\n".join(want), "\n".join(got))
                    )
        return len(examples), problems
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def run_doc(args):
    root = args.root or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    blocks, rewritten, problems = doc_check(root, args.sync)
    ran = 0
    if args.run and not problems:
        ran, more = doc_run(root, args.cc, args.sanitize)
        problems += more
    for p in problems:
        sys.stderr.write("%s: %s\n" % (PROG, p))
    if problems:
        return 1
    msg = "%d example block%s match their programs" % (blocks, "" if blocks == 1 else "s")
    if rewritten:
        msg += ", %d rewritten" % rewritten
    if args.run:
        msg += ", %d program%s compiled and ran" % (ran, "" if ran == 1 else "s")
    sys.stderr.write("%s: %s\n" % (PROG, msg))
    return 0


# ----------------------------------------------------------------- collisions

COLL_EXTENSIONS = (".so", ".a", ".dylib", ".tbd", ".lib")
COLL_TBD_LIST = re.compile(r"(?:^|\s)(?:weak-|thread-local-)?symbols:\s*\[([^\]]*)\]", re.S)


def coll_is_library(name):
    return name.endswith(COLL_EXTENSIONS) or re.search(r"\.so(\.[0-9]+)+$", name) is not None


def coll_symbols(path):
    """The global names a library defines, spelled the way C spells them."""
    with open(path, "rb") as f:
        magic = f.read(8)
    if path.endswith(".tbd"):
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
        out = set()
        for body in COLL_TBD_LIST.findall(text):
            for s in body.split(","):
                s = s.strip().strip("'\"")
                if s.startswith("_"):
                    out.add(s[1:])
        return out
    elf = magic[:4] == b"\x7fELF"
    macho = magic[:4] in (b"\xcf\xfa\xed\xfe", b"\xce\xfa\xed\xfe", b"\xca\xfe\xba\xbe")
    # An archive does not say what it holds without opening a member, and the
    # only archives with a leading underscore on every C name are Apple's.
    underscore = macho or (magic.startswith(b"!<arch>") and sys.platform == "darwin")
    argv = ["nm", "-D" if elf else "-g", "--defined-only", path]
    try:
        res = subprocess.run(argv, capture_output=True, text=True, errors="replace")
    except OSError:
        raise Error("needs nm on PATH to read %s" % path)
    if res.returncode != 0 and not res.stdout:
        raise Error("nm could not read %s: %s" % (path, res.stderr.strip()))
    out = set()
    for line in res.stdout.split("\n"):
        parts = line.split()
        if len(parts) < 2 or line.endswith(":"):
            continue
        name = parts[-1].split("@", 1)[0]
        if underscore:
            if not name.startswith("_"):
                continue
            name = name[1:]
        out.add(name)
    return out


def coll_libraries(paths):
    out = []
    for p in paths:
        if os.path.isdir(p):
            for n in sorted(os.listdir(p)):
                full = os.path.join(p, n)
                if os.path.isfile(full) and coll_is_library(n):
                    out.append(full)
        elif os.path.isfile(p):
            out.append(p)
        else:
            raise Error("%s is not a file or a directory" % p)
    # libz.so, libz.so.1 and libz.so.1.3 are one library.
    seen = set()
    uniq = []
    for p in out:
        real = os.path.realpath(p)
        if real not in seen:
            seen.add(real)
            uniq.append(p)
    return uniq


def coll_planned(root, api_dir):
    """Every func, method and var in Go's API, under the C name it will have."""
    import importlib.machinery
    import importlib.util

    path = os.path.join(root, "tools", "burrow-coverage")
    loader = importlib.machinery.SourceFileLoader("burrow_coverage", path)
    spec = importlib.util.spec_from_loader("burrow_coverage", loader)
    cov = importlib.util.module_from_spec(spec)
    loader.exec_module(cov)
    if api_dir is None:
        api_dir = os.path.join(cov.goroot(), "api")
    out = {}
    for pkg, decls in sorted(cov.read_api(api_dir, cov.TARGETS).items()):
        if re.search(r"(^|/)(internal|vendor)(/|$)", pkg):
            continue
        for d in decls:
            if not re.match(r"(func|method|var) ", d.text):
                continue
            cov.map_decl(d)
            if d.owner is None and d.cname:
                out.setdefault(d.cname, "%s %s" % (pkg, d.key))
    return out


def coll_waivers(path):
    out = []
    if not os.path.exists(path):
        return out
    with open(path) as f:
        for n, line in enumerate(f, 1):
            line = line.split("#", 1)[0].strip()
            if not line:
                continue
            parts = line.split(None, 2)
            if len(parts) < 3:
                raise Error("%s:%d: a waiver is a name, a library pattern and a reason" % (path, n))
            out.append((parts[0], parts[1]))
    return out


def run_collisions(args):
    import fnmatch

    root = args.root or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    built = {}
    for obj in args.burrow or [os.path.join(root, "build", "libburrow.a")]:
        if not os.path.exists(obj):
            raise Error("%s does not exist, so build burrow first or name the library with --burrow" % obj)
        for name in coll_symbols(obj):
            built[name] = os.path.basename(obj)
    planned = {} if args.no_planned else coll_planned(root, args.go_api)
    waivers = coll_waivers(args.waivers or os.path.join(root, "tools", "collision-waivers.txt"))

    libraries = coll_libraries(args.libraries)
    # One name is often in many libraries, libSystem's re-exports on macOS
    # most of all, so the report is by name with the libraries listed after.
    found = {}
    waived = 0
    symbols = 0
    import concurrent.futures

    # nm is most of the time, and it is one process per library, so they run
    # side by side.
    with concurrent.futures.ThreadPoolExecutor(max_workers=os.cpu_count() or 4) as pool:
        tables = list(pool.map(coll_symbols, libraries))
    for lib, theirs in zip(libraries, tables):
        symbols += len(theirs)
        base = os.path.basename(lib)
        for name in theirs:
            if name not in built and name not in planned:
                continue
            if any(n == name and fnmatch.fnmatch(base, pat) for n, pat in waivers):
                waived += 1
                continue
            found.setdefault(name, []).append(lib)

    for name in sorted(found):
        if name in built:
            ours = "defined in %s" % built[name]
        else:
            ours = "planned for %s" % planned[name]
        libs = found[name]
        more = "" if len(libs) <= 3 else " and %d more" % (len(libs) - 3)
        sys.stderr.write(
            "%s: %s is %s, and %s%s define%s it too\n"
            % (PROG, name, ours, ", ".join(os.path.basename(x) for x in libs[:3]), more,
               "s" if len(libs) == 1 else "")
        )
    sys.stderr.write(
        "%s: %d names burrow defines and %d it will, against %d symbols from %d libraries: "
        "%d collision%s, %d waived\n"
        % (PROG, len(built), len(set(planned) - set(built)), symbols, len(libraries),
           len(found), "" if len(found) == 1 else "s", waived)
    )
    return 1 if found else 0


def main():
    p = argparse.ArgumentParser(
        prog=PROG,
